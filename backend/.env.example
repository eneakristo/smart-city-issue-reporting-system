# Required database connection.
SPRING_DATASOURCE_URL=jdbc:postgresql://your-supabase-host:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_database_password

# Required for login/session JWT signing. Use a long random value and keep it private.
APP_JWT_SECRET=replace_with_a_long_random_secret

# Required only if users can upload issue images.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=issue-image

# Optional: bootstrap one existing user as SYSTEM_ADMIN during startup.
APP_SYSTEM_ADMIN_EMAIL=admin@example.com

# Optional: password reset email delivery through Brevo.
BREVO_API_KEY=your_brevo_api_key
APP_EMAIL_FROM_ADDRESS=no-reply@example.com
APP_EMAIL_FROM_NAME=Smart City Issue Reporting

# Local frontend URL used inside password reset emails.
APP_PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password

# Local CORS origin for the Vite dev server.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
